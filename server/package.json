{
  "name": "alto-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "kpi": "node --env-file-if-exists=.env src/scripts/kpi.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/api.test.js",
    "mail:test": "node --env-file-if-exists=.env src/scripts/mail-test.js",
    "seed:atlas": "node --env-file-if-exists=.env --env-file=.env.atlas src/scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  }
}
