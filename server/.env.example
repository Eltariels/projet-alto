API_PORT=4000
MONGO_URI=mongodb://localhost:27017/alto
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# E-mails (mot de passe oublié)
# Développement : Mailpit (docker compose), boîte de réception sur http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=ALTO <no-reply@alto.local>
# Production, par exemple avec Brevo (offre gratuite, 300 e-mails / jour) :
# SMTP_URL=smtp://IDENTIFIANT_SMTP:CLE_SMTP@smtp-relay.brevo.com:587
# MAIL_FROM=ALTO <no-reply@votre-domaine.fr>
# Sans SMTP_URL, les e-mails sont seulement affichés dans la console du serveur.
