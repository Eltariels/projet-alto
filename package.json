{
  "name": "alto",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d mongo mailpit",
    "db:down": "docker compose down",
    "db:seed": "npm run seed -w server",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "kpi": "npm run kpi -w server",
    "test": "npm run test -w server",
    "mail:test": "npm run mail:test -w server --"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "type": "module"
}
